{
  "name": "frontend",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "cross-env EXPO_USE_DEV_CLIENT=0 expo start --go --lan",
    "start:dev": "cross-env EXPO_USE_DEV_CLIENT=1 expo start --dev-client --lan",
    "start:dev:tunnel": "cross-env EXPO_USE_DEV_CLIENT=1 expo start --dev-client --tunnel",
    "start:go": "cross-env EXPO_USE_DEV_CLIENT=0 expo start --go --lan",
    "start:go:tunnel": "cross-env EXPO_USE_DEV_CLIENT=0 expo start --go --tunnel",
    "start:tunnel": "cross-env EXPO_USE_DEV_CLIENT=1 expo start --tunnel",
    "start:lan": "cross-env EXPO_USE_DEV_CLIENT=1 expo start --lan",
    "android:usb": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:3000 tcp:3000 && cross-env EXPO_USE_DEV_CLIENT=0 REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo start --go",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "android:go": "expo start --go --android",
    "android:dev": "cross-env EXPO_USE_DEV_CLIENT=1 expo start --dev-client --android",
    "build:android:dev": "cross-env EXPO_USE_DEV_CLIENT=1 eas build --profile development --platform android",
    "gen:mwa-icon": "node scripts/gen-mwa-icon.mjs",
    "build:dapp-store": "eas build --profile dapp-store --platform android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "postinstall": "node scripts/patch-expo-cors.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@privy-io/expo": "^0.65.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "@solana-mobile/mobile-wallet-adapter-protocol": "^2.2.8",
    "@solana-mobile/mobile-wallet-adapter-protocol-web3js": "^2.2.8",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.100.10",
    "bs58": "^4.0.1",
    "buffer": "^6.0.3",
    "expo": "~55.0.24",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.15",
    "expo-dev-client": "~55.0.35",
    "expo-device": "~55.0.17",
    "expo-font": "~55.0.7",
    "expo-glass-effect": "~55.0.11",
    "expo-image": "~55.0.10",
    "expo-image-picker": "~55.0.20",
    "expo-linking": "~55.0.15",
    "expo-notifications": "~55.0.23",
    "expo-router": "~55.0.14",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.8",
    "expo-system-ui": "~55.0.18",
    "expo-web-browser": "~55.0.16",
    "js-base64": "^3.7.8",
    "nativewind": "^4.2.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "tailwindcss": "^3.4.19",
    "tweetnacl": "^1.0.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/bs58": "^4.0.4",
    "@types/react": "~19.2.2",
    "cross-env": "^7.0.3",
    "sharp": "^0.35.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
